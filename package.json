{
  "name": "gi-hub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss --input ./src/assets/stylesheets/index.css --output ./out/assets/stylesheets/index.css --minify",
    "build:copy": "node ./scripts/copy-static.mjs",
    "build:locales": "node ./scripts/build-locales.mjs",
    "build": "npm run build:copy && npm run build:css && npm run build:locales",
    "clean": "rm -rf ./out"
  },
  "dependencies": {
    "@tailwindcss/cli": "4.0.5",
    "tailwindcss": "4.0.5"
  }
}
